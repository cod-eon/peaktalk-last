# Better Auth server runtime (values supplied outside Git). This must be a
# standard node-postgres URI, for example postgresql://…@postgres:5432/peaktalk.
# Do not copy FastAPI's postgresql+asyncpg:// DATABASE_URL here.
BETTER_AUTH_DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
# Choose exactly one delivery provider. REG.RU Hosting Mail uses the SMTP
# values below; Resend remains a supported alternative.
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=465
AUTH_SMTP_SECURE=true
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=

# Browser-visible backend route
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_HCAPTCHA_SITEKEY=

# Development/test only; never configure in production.
AUTH_MAIL_CAPTURE_URL=
