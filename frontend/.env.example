# =============================================================================
# PeakTalk Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in ALL values.
#
#   cp frontend/.env.example frontend/.env.local
#
# IMPORTANT:
#   - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
#     Do NOT put secrets in NEXT_PUBLIC_ variables.
#   - Next.js bakes NEXT_PUBLIC_ vars into the JS at BUILD TIME.
#     If you change them, you must rebuild the Docker image.
#   - Never commit .env.local to git.
# =============================================================================


# ── Logto (Auth) ──────────────────────────────────────────────────────────────
# These values are runtime-only for the Next.js server. Keep the app secret and
# cookie secret out of NEXT_PUBLIC_* variables and out of Git.
LOGTO_ENDPOINT=https://auth.peaktalk.ru
LOGTO_APP_ID=YOUR_LOGTO_APP_ID
LOGTO_APP_SECRET=YOUR_LOGTO_APP_SECRET
LOGTO_COOKIE_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Shared only with FastAPI to verify short-lived server-signed identity claims.
# The deploy workflow derives it from LOGTO_COOKIE_SECRET unless overridden.
LOGTO_IDENTITY_ASSERTION_SECRET=
LOGTO_API_RESOURCE=https://peaktalk.ru/api
APP_BASE_URL=https://peaktalk.ru


# ── Backend API ───────────────────────────────────────────────────────────────
# The URL the browser uses to reach the FastAPI backend.
# In production: https://YOUR_DOMAIN/api  (nginx strips /api prefix before forwarding)
# In local dev:  http://localhost:8000
NEXT_PUBLIC_API_URL=https://YOUR_DOMAIN/api


# ── hCaptcha ──────────────────────────────────────────────────────────────────
# Used on login/register pages to prevent bots.
# Get your sitekey at: https://dashboard.hcaptcha.com
# The sitekey is public — safe to expose.
NEXT_PUBLIC_HCAPTCHA_SITEKEY=YOUR_HCAPTCHA_SITE_KEY
