# =============================================================================
# PeakTalk Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in ALL values before starting the app.
#
#   cp backend/.env.example backend/.env
#
# IMPORTANT: Never commit .env to git. It contains secrets.
# =============================================================================


# ── Database ──────────────────────────────────────────────────────────────────
# In production (Docker), docker-compose.yml overrides this automatically
# to point at the internal postgres container: postgres:5432
# You still need POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below.
DATABASE_URL=postgresql+asyncpg://peaktalk:CHANGE_ME@postgres:5432/peaktalk

# These three values are used by docker-compose.yml to initialize PostgreSQL
POSTGRES_USER=peaktalk
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=peaktalk


# ── Supabase (Auth + Storage — cloud) ─────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Use the SERVICE_ROLE key (NOT the anon key) — backend admin operations
# Found in: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_KEY=eyJhbGci...YOUR_SERVICE_ROLE_KEY...

# Name of your Supabase Storage bucket
# Create it in: Supabase Dashboard → Storage → New bucket
SUPABASE_STORAGE_BUCKET=peaktalk-prod-bucket


# ── AI ────────────────────────────────────────────────────────────────────────
# Cloud.ru Foundation Models OpenAI-compatible API
# Docs: https://cloud.ru/docs/foundation-models/ug/topics/api-ref
# Create an access key in Cloud.ru Evolution → Foundation Models → Use model
CLOUD_RU_API_KEY=YOUR_CLOUD_RU_API_KEY
CLOUD_RU_BASE_URL=https://foundation-models.api.cloud.ru/v1
# Current default model for PeakTalk
CLOUD_RU_MODEL=Qwen/Qwen3-Coder-Next
# Request timeout for AI calls
CLOUD_RU_TIMEOUT_SECONDS=30
# Keep false unless you explicitly want an extra LLM call for anti-AI detection on user answers
AI_DETECTION_LLM_ENABLED=false


# ── Redis (Celery task queue) ─────────────────────────────────────────────────
# In production (Docker), overridden by docker-compose.yml to redis://redis:6379/0
REDIS_URL=redis://redis:6379/0


# ── Web Push (VAPID) ──────────────────────────────────────────────────────────
# Required for browser push notifications.
# Generate keys with either:
#   python backend/gen_vapid.py
# or:
#   npx web-push generate-vapid-keys --json
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:hello@peaktalk.ru


# ── Application ───────────────────────────────────────────────────────────────
# "production" disables /docs and /redoc Swagger UI
APP_ENV=production
DEBUG=false


# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Must exactly match what the browser sends (protocol + domain + optional port).
# Example: https://peaktalk.io,https://www.peaktalk.io
ALLOWED_ORIGINS=https://YOUR_DOMAIN


# ── Supabase Webhook Secret ───────────────────────────────────────────────────
# Verifies incoming webhook requests are from Supabase (not random callers).
# Set in: Supabase Dashboard → Database → Webhooks → HTTP Headers
# Generate with: openssl rand -hex 32
SUPABASE_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_-hex_32


# ── YooKassa Payment Gateway ─────────────────────────────────────────────────
# Found in: YooKassa Dashboard → Integration → Keys
# Use test_* keys for testing, live_* for production.
#
# Тестовый магазин:
#   1. В ЛК ЮКассы переключитесь на «Тестовый магазин» (верхнее меню)
#   2. Скопируйте test shop_id и test secret_key
#   3. Тестовые карты: 1111 1111 1111 1026 (успех), 1111 1111 1111 1019 (отказ)
#   4. Вебхуки работают так же — настройте URL в тестовом магазине
#
PAYMENTS_ENABLED=true
YOOKASSA_SHOP_ID=YOUR_SHOP_ID
YOOKASSA_SECRET_KEY=test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Optional: if you set a webhook secret in YooKassa dashboard
YOOKASSA_WEBHOOK_SECRET=

# 54-FZ receipt settings.
# Самозанятые (НПД) НЕ используют ККТ — чеки формируются через «Мой налог».
# Установите true, только если вы ИП/ООО с подключённым ОФД.
YOOKASSA_SEND_RECEIPT=false
# tax_system_code: 1=ОСН, 2=УСН доход, 3=УСН доход-расход, 6=ПСН
# vat_code: 1=без НДС, 3=10%, 4=20%
# YOOKASSA_TAX_SYSTEM_CODE=2
# YOOKASSA_VAT_CODE=1

# Public frontend URL (used as return_url after payment)
FRONTEND_URL=https://peaktalk.ru
