# =============================================================================
# PeakTalk Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in ALL values before starting the app.
#
#   cp backend/.env.example backend/.env
#
# IMPORTANT: Never commit .env to git. It contains secrets.
# =============================================================================


# ── Database ──────────────────────────────────────────────────────────────────
# In production (Docker), docker-compose.yml overrides this automatically
# to point at the internal postgres container: postgres:5432
# You still need POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB below.
DATABASE_URL=postgresql+asyncpg://peaktalk:CHANGE_ME@postgres:5432/peaktalk

# These three values are used by docker-compose.yml to initialize PostgreSQL
POSTGRES_USER=peaktalk
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=peaktalk


# ── Supabase (Auth + Storage — cloud) ─────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Use the SERVICE_ROLE key (NOT the anon key) — backend admin operations
# Found in: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_KEY=eyJhbGci...YOUR_SERVICE_ROLE_KEY...

# Name of your Supabase Storage bucket
# Create it in: Supabase Dashboard → Storage → New bucket
SUPABASE_STORAGE_BUCKET=peaktalk-prod-bucket


# ── AI ────────────────────────────────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...YOUR_GEMINI_KEY...


# ── Redis (Celery task queue) ─────────────────────────────────────────────────
# In production (Docker), overridden by docker-compose.yml to redis://redis:6379/0
REDIS_URL=redis://redis:6379/0


# ── Application ───────────────────────────────────────────────────────────────
# "production" disables /docs and /redoc Swagger UI
APP_ENV=production
DEBUG=false


# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slash).
# Must exactly match what the browser sends (protocol + domain + optional port).
# Example: https://peaktalk.io,https://www.peaktalk.io
ALLOWED_ORIGINS=https://YOUR_DOMAIN


# ── Supabase Webhook Secret ───────────────────────────────────────────────────
# Verifies incoming webhook requests are from Supabase (not random callers).
# Set in: Supabase Dashboard → Database → Webhooks → HTTP Headers
# Generate with: openssl rand -hex 32
SUPABASE_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_-hex_32
