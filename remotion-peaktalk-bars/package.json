{
  "name": "remotion-peaktalk-bars",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "still": "remotion still src/index.ts PeakTalkBars out/peaktalk-bars-frame90.png --frame=90 --scale=0.5",
    "still:logo": "remotion still src/index.ts PeakTalkLogo out/peaktalk-logo-frame210.png --frame=210 --scale=0.5",
    "still:simulation": "remotion still src/index.ts PeakTalkSimulationMockup out/peaktalk-simulation-frame180.png --frame=180 --scale=0.5",
    "still:simulation:late": "remotion still src/index.ts PeakTalkSimulationMockup out/peaktalk-simulation-frame300.png --frame=300 --scale=0.5",
    "render": "remotion render src/index.ts PeakTalkBars out/peaktalk-bars.mp4",
    "render:logo": "remotion render src/index.ts PeakTalkLogo out/peaktalk-logo.mp4 --codec=h264 --crf=12 --pixel-format=yuv420p --x264-preset=slow --muted",
    "render:simulation": "remotion render src/index.ts PeakTalkSimulationMockup out/peaktalk-simulation-mockup.mp4 --codec=h264 --crf=14 --pixel-format=yuv420p --x264-preset=slow --muted",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.472"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.472",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
