# =============================================================================
# PeakTalk — .gitignore
# =============================================================================

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
frontend/.next/
frontend/out/
frontend/build/
frontend/.turbo/

# ── Environment files (NEVER commit these — they contain secrets!) ───────────
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local

# .env.example files SHOULD be committed (they contain no secrets)
!backend/.env.example
!frontend/.env.example

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
htmlcov/
*.pyc

# ── Docker ────────────────────────────────────────────────────────────────────
# Don't ignore docker-compose files — they are part of the project
# .docker/  (only if you store secrets there)

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── IDE ────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── PWA (generated files) ────────────────────────────────────────────────────
frontend/public/sw.js
frontend/public/workbox-*.js

# ── TypeScript build info ─────────────────────────────────────────────────────
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# ── Claude internal ───────────────────────────────────────────────────────────
.claude/
