[
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 0,
    "start": 0.0,
    "end": 0.15000000000000013,
    "speaker": "A",
    "text": "Вот тут."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 1,
    "start": 1.0000000000000002,
    "end": 3.1499999999999995,
    "speaker": "A",
    "text": "А нам пишут, проверь это, сделай то,"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 2,
    "start": 3.1999999999999993,
    "end": 4.1,
    "speaker": "A",
    "text": "пятое, десятое."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 3,
    "start": 4.6,
    "end": 14.900000000000002,
    "speaker": "A",
    "text": "Но это уже пока не думай об этом. Короче, изначально нужно делать хуйню, которая поможет взять твой текст,"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 4,
    "start": 15.000000000000004,
    "end": 16.900000000000002,
    "speaker": "A",
    "text": "как любой,"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 5,
    "start": 17.05,
    "end": 21.3,
    "speaker": "A",
    "text": "сделать под него правильный текст,"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 6,
    "start": 21.45,
    "end": 25.599999999999998,
    "speaker": "A",
    "text": "подбить по твой формат, под все, что ты хочешь."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 7,
    "start": 26.74,
    "end": 27.09,
    "speaker": "B",
    "text": "Угу."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 8,
    "start": 27.59,
    "end": 39.84,
    "speaker": "A",
    "text": "И при этом сделать тебе какую-нибудь типа мини презентажку, коротенькую там вырезку по этой всей хуине."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 9,
    "start": 40.24,
    "end": 42.540000000000006,
    "speaker": "A",
    "text": "Ну и там какие-то уже особенности."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 10,
    "start": 42.74,
    "end": 53.99,
    "speaker": "A",
    "text": "Но я считаю, что нужно делать там условно один-два бесплатных тестовых заказа."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 11,
    "start": 54.708,
    "end": 59.507999999999996,
    "speaker": "A",
    "text": "Типа новый пользователь, у него есть один или два там тестовых этих базовая"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 12,
    "start": 61.458,
    "end": 64.80799999999999,
    "speaker": "A",
    "text": "подписка, когда, ну, по сути, она что делает?"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 13,
    "start": 65.008,
    "end": 68.80799999999999,
    "speaker": "A",
    "text": "Смотрит твой текст, подсвечивает зоны, ну, всякие узкие места,"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 14,
    "start": 68.958,
    "end": 71.008,
    "speaker": "A",
    "text": "говорит, где нелогично, ну и прочую хуйню."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 15,
    "start": 71.55799999999999,
    "end": 72.008,
    "speaker": "C",
    "text": "Угу."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 16,
    "start": 73.408,
    "end": 76.05799999999999,
    "speaker": "A",
    "text": "А средняя подписка, она"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 17,
    "start": 79.358,
    "end": 80.408,
    "speaker": "A",
    "text": "за тебя все правит."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 18,
    "start": 81.364,
    "end": 87.714,
    "speaker": "A",
    "text": "и делает тебе типа сухую выжимку того что ты скинул типа"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 19,
    "start": 87.714,
    "end": 88.214,
    "speaker": "D",
    "text": "Угу."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 20,
    "start": 88.214,
    "end": 102.414,
    "speaker": "A",
    "text": "основное и максимально это когда она готовит сверху еще там красивую приязву возможно какие-то там пилит приложение и прочую хуйню понял"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 21,
    "start": 110.036,
    "end": 111.986,
    "speaker": "A",
    "text": "Да-да-да, на пацаннику надо думать."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 22,
    "start": 112.436,
    "end": 116.786,
    "speaker": "A",
    "text": "Надо сделать, чтобы было пока прям вообще ни до хера."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 23,
    "start": 117.386,
    "end": 121.536,
    "speaker": "E",
    "text": "Да больше вопрос типа в том, как это продвигать, это самое тяжелое типа."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 24,
    "start": 121.736,
    "end": 123.136,
    "speaker": "A",
    "text": "Легко, вообще легко."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 25,
    "start": 123.936,
    "end": 128.236,
    "speaker": "E",
    "text": "Соцсети, вести вот эти карусели в инстаграме, делать, это такой дрочь просто"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 26,
    "start": 128.236,
    "end": 128.436,
    "speaker": "A",
    "text": "Все,"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 27,
    "start": 128.436,
    "end": 128.686,
    "speaker": "E",
    "text": "пипец."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 28,
    "start": 128.686,
    "end": 129.886,
    "speaker": "A",
    "text": "да нет,"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 29,
    "start": 130.036,
    "end": 130.586,
    "speaker": "A",
    "text": "это все херня."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 30,
    "start": 132.986,
    "end": 135.436,
    "speaker": "A",
    "text": "Мы найдем все."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 31,
    "start": 136.628,
    "end": 137.97799999999998,
    "speaker": "A",
    "text": "Чатики в ТГ со"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 32,
    "start": 137.97799999999998,
    "end": 138.628,
    "speaker": "E",
    "text": "Угу."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 33,
    "start": 138.628,
    "end": 143.928,
    "speaker": "A",
    "text": "всякими ведущими и прочих. И начнем туда просто спамить эту рекламу и бану."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 34,
    "start": 144.778,
    "end": 145.22799999999998,
    "speaker": "A",
    "text": "Все."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 35,
    "start": 146.178,
    "end": 148.278,
    "speaker": "E",
    "text": "Ну это резонно, да, это интересно."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 36,
    "start": 149.07799999999997,
    "end": 151.028,
    "speaker": "A",
    "text": "Обо всяких ВК-шных историях."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 37,
    "start": 154.32799999999997,
    "end": 156.72799999999998,
    "speaker": "A",
    "text": "У меня была мысль начать"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 38,
    "start": 158.82799999999997,
    "end": 159.878,
    "speaker": "A",
    "text": "вести"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 39,
    "start": 162.528,
    "end": 163.628,
    "speaker": "A",
    "text": "какой-нибудь кулинарный блог."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 40,
    "start": 166.676,
    "end": 180.326,
    "speaker": "A",
    "text": "может быть мы сможем что-то придумать типа ну я не знаю мне надо подумать тоже я вот хотел начать записывать видосы типа как я готовлю там такие"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 41,
    "start": 181.476,
    "end": 182.87599999999998,
    "speaker": "E",
    "text": "Это охуенно вообще."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 42,
    "start": 184.212,
    "end": 184.462,
    "speaker": "E",
    "text": "Типа,"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 43,
    "start": 184.462,
    "end": 184.712,
    "speaker": "A",
    "text": "Че?"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 44,
    "start": 184.712,
    "end": 186.362,
    "speaker": "E",
    "text": "ну это охуенно."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 45,
    "start": 186.512,
    "end": 197.56199999999998,
    "speaker": "E",
    "text": "Я сколько раз, я вижу постоянно типа в инсте, в ютубе появляются какие-то там тоже маленькое количество подписчиков, там за неделю они стреляют просто на том, что на своей кухне готовят что-то, причем"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 46,
    "start": 197.56199999999998,
    "end": 197.712,
    "speaker": "A",
    "text": "Ну"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 47,
    "start": 197.712,
    "end": 197.91199999999998,
    "speaker": "E",
    "text": "не всегда"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 48,
    "start": 197.91199999999998,
    "end": 198.16199999999998,
    "speaker": "A",
    "text": "вот мы,"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 49,
    "start": 198.16199999999998,
    "end": 198.262,
    "speaker": "E",
    "text": "оригинально."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 50,
    "start": 198.262,
    "end": 203.112,
    "speaker": "A",
    "text": "я короче че-нибудь придумаю, как-нибудь тебя не дерну."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 51,
    "start": 206.91199999999998,
    "end": 208.16199999999998,
    "speaker": "E",
    "text": "Ты что-то опять завис,"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 52,
    "start": 208.362,
    "end": 209.212,
    "speaker": "E",
    "text": "по-моему."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 53,
    "start": 214.932,
    "end": 214.932,
    "speaker": "A",
    "text": "Что там?"
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 54,
    "start": 214.932,
    "end": 217.832,
    "speaker": "E",
    "text": "Алло, алло, алло, алло, алло."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 55,
    "start": 221.332,
    "end": 223.582,
    "speaker": "E",
    "text": "Ну что-то сейчас плохо со связью."
  },
  {
    "call": "2026-06-24-call-2",
    "chunk_index": 0,
    "segment_index": 56,
    "start": 223.932,
    "end": 225.332,
    "speaker": "E",
    "text": "Наверное, в Перикс ушел."
  }
]